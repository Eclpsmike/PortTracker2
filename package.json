{
  "name": "porttracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5187 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "prebuild": "node --import tsx scripts/render-fallback.tsx",
    "server": "node --env-file=server/.env --import tsx server/index.ts",
    "server:dev": "node --env-file=server/.env --import tsx --watch server/index.ts",
    "db:migrate": "node --env-file=server/.env.migrations --import tsx server/migrate.ts",
    "db:provision": "node --import tsx server/provision.ts",
    "test:server": "node --env-file=server/.env --import tsx --test server/tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "fastify": "^5.12.8",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
